# Copy this file to .env (or .env.local) inside apps/web and fill in your token.
#
# Optional GitHub Personal Access Token (no scopes needed for public data).
# Raises the GitHub REST API rate limit from 60 requests/hour to 5,000 requests/hour.
# Create one at https://github.com/settings/tokens
# WARNING: Because this is a Vite frontend variable, it is exposed to the browser.
# Do not use a token with private-repository or write permissions.
VITE_GITHUB_TOKEN=
